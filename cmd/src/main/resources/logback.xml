<?xml version="1.0" encoding="UTF-8"?>
<!--
  cmd 模块复用 core 的 logback-spring.xml；
  仅做差异化覆盖：cmd 默认开启 generator DEBUG 级别（便于排查命令行执行问题）。
  通过 -Dlog.generator.level=INFO 可还原为安静模式。
-->
<configuration scan="false" debug="false">
    <include resource="logback-spring.xml"/>
    <logger name="org.hyw.tools.generator" level="${log.generator.level:-DEBUG}" />
</configuration>
