<?xml version="1.0" encoding="UTF-8"?>
<configuration scan="false" debug="false">
    <appender name="stdout" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">
            <pattern>%-15d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{80} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Generator 自身日志（默认 INFO，调试时通过 -Dlog.generator.level=DEBUG 切换） -->
    <logger name="org.hyw.tools.generator" level="${log.generator.level:-INFO}" />

    <root level="WARN">
        <appender-ref ref="stdout" />
    </root>
</configuration>
